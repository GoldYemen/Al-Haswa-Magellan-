<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hawsa_bg_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="60dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"><!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hawsa_app_title"
                        android:textSize="28sp"
                        android:textColor="#D4AF37"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:shadowColor="#D4AF3740"
                        android:shadowRadius="8"
                        android:shadowDx="0"
                        android:shadowDy="0" />

                    <TextView
                        android:id="@+id/tv_app_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hawsa_app_subtitle"
                        android:textSize="13sp"
                        android:textColor="#A8B8D0"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_hawsa_logo"
                    android:contentDescription="@string/hawsa_logo_desc"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <!-- Gold separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="#D4AF37"
                android:layout_marginBottom="16dp"
                android:alpha="0.5" />

            <!-- Card 1: Map -->
            <FrameLayout
                android:id="@+id/card_map"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/hawsa_card_map_bg"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/hawsa_icon_circle"
                        android:backgroundTint="@color/hawsa_icon_circle_blue">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hawsa_map" />
                    </FrameLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#D4AF37" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_map_card"
                            android:textSize="19sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:letterSpacing="0.01" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_map_card_desc"
                            android:textSize="12sp"
                            android:textColor="@color/hawsa_subtitle_map"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Card 2: Tides -->
            <FrameLayout
                android:id="@+id/card_tides"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/hawsa_card_tides_bg"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/hawsa_icon_circle"
                        android:backgroundTint="@color/hawsa_icon_circle_teal">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hawsa_tides" />
                    </FrameLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#D4AF37" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_tides_card"
                            android:textSize="19sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:letterSpacing="0.01" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_tides_card_desc"
                            android:textSize="12sp"
                            android:textColor="@color/hawsa_subtitle_tides"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Card 3: Moon -->
            <FrameLayout
                android:id="@+id/card_moon"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/hawsa_card_moon_bg"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/hawsa_icon_circle"
                        android:backgroundTint="@color/hawsa_icon_circle_purple">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hawsa_moon" />
                    </FrameLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#D4AF37" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_moon_card"
                            android:textSize="19sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:letterSpacing="0.01" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_moon_card_desc"
                            android:textSize="12sp"
                            android:textColor="@color/hawsa_subtitle_moon"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Card 4: Compass -->
            <FrameLayout
                android:id="@+id/card_compass"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/hawsa_card_compass_bg"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/hawsa_icon_circle"
                        android:backgroundTint="@color/hawsa_icon_circle_gold">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hawsa_compass" />
                    </FrameLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#D4AF37" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_compass_card"
                            android:textSize="19sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:letterSpacing="0.01" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_compass_card_desc"
                            android:textSize="12sp"
                            android:textColor="@color/hawsa_subtitle_compass"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:background="@color/hawsa_bg_main"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D4AF37"
            android:alpha="0.35"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tv_designer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hawsa_designer_credit"
            android:textSize="11sp"
            android:textColor="#D4AF37"
            android:alpha="0.85" />
    </LinearLayout>

</FrameLayout>