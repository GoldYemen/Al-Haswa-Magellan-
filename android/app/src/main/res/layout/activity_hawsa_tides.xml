<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A"
    android:padding="0dp"
    android:layoutDirection="rtl">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#E60D1B2A"
        android:layoutDirection="rtl">

        <ImageView
            android:id="@+id/btn_tides_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_hawsa_back"
            android:contentDescription="@string/hawsa_back"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tv_tides_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hawsa_tides_title"
            android:textSize="20sp"
            android:textColor="#D4AF37"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingEnd="36dp" />
    </LinearLayout>

    <!-- Current tide status -->
    <TextView
        android:id="@+id/tv_current_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#10B981"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textStyle="bold" />

    <!-- Station name / location -->
    <TextView
        android:id="@+id/tv_tides_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#778DA9"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="4dp" />

    <!-- Tide chart -->
    <app.alhaswamagellan.hawsa.TideChartView
        android:id="@+id/tide_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Day selector pills -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/day_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center" />
    </HorizontalScrollView>

    <!-- Weekly summary -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:fillViewport="true"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/weekly_tides_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Designer credit -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hawsa_designer_credit"
        android:textSize="10sp"
        android:textColor="#415A77"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="8dp" />

</LinearLayout>